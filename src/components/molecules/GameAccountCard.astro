---
import Icon from "@components/atoms/display/Icon.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { GameAccount, ProfileGame } from "@/types/gameAccount";
import { url } from "@utils/url-utils";

interface Props {
	account: GameAccount;
	avatar?: string;
}
const { account, avatar } = Astro.props;
const titles: Record<ProfileGame, I18nKey> = {
	genshin: I18nKey.gameAccountGenshin,
	starrail: I18nKey.gameAccountStarrail,
	zzz: I18nKey.gameAccountZZZ,
	endfield: I18nKey.gameAccountEndfield,
	arknights: I18nKey.gameAccountArknights,
	nte: I18nKey.gameAccountNTE,
	bluearchive: I18nKey.gameAccountBlueArchive,
};
const stats = [
	{ label: I18nKey.gameStatLevel, value: account.level },
	{ label: I18nKey.gameStatWorldLevel, value: account.worldLevel },
	{ label: I18nKey.gameStatAchievements, value: account.achievements },
	{ label: I18nKey.gameStatShowcase, value: account.characters },
].filter(({ value }) => value !== undefined);
const ready = account.status === "ready";
---
<article
	class:list={["profile-game", { "profile-game--banner": ready }]}
	data-profile-game={account.game}
	data-account-status={account.status}
>
	{account.artwork && <img class="profile-game__artwork" src={url(account.artwork)} alt="" loading="lazy" decoding="async" />}
	<header class="profile-game__header">
		{ready && avatar ? (
			<img class="profile-game__avatar" src={url(avatar)} alt="" width="56" height="56" loading="lazy" decoding="async" />
		) : (
			<span class="profile-game__icon" aria-hidden="true">
				<Icon icon="material-symbols:sports-esports-outline-rounded" width={24} height={24} />
			</span>
		)}
		<div class="profile-game__identity">
			<h3>{i18n(titles[account.game])}</h3>
			{ready && <p class="profile-game__name">{account.nickname}</p>}
			<code>UID {account.uid}</code>
		</div>
	</header>
	{ready ? (
		<>
			{!!stats.length && (
				<dl class="profile-game__stats">
					{stats.map(({ label, value }) => (
						<div class="profile-game__stat">
							<dt>{i18n(label)}</dt>
							<dd>{value}</dd>
						</div>
					))}
				</dl>
			)}
			{(account.signature || account.profileUrl) && (
				<footer class="profile-game__footer">
					{account.signature && <p class="profile-game__signature">{account.signature}</p>}
					{account.profileUrl && <a href={account.profileUrl} target="_blank" rel="noopener noreferrer" class="profile-game__provider">{account.source}<Icon icon="material-symbols:arrow-outward-rounded" width={16} height={16} /></a>}
				</footer>
			)}
		</>
	) : <p class="profile-game__unavailable">{i18n(I18nKey.gameAccountNoPublicData)}</p>}
</article>
