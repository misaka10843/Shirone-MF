---
import Icon from "@components/atoms/display/Icon.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { PostAiDisclosure } from "@/utils/post-ai-schema";

interface Props {
	disclosure: PostAiDisclosure;
	compact?: boolean;
}

const { disclosure, compact = false } = Astro.props;
const label = i18n(disclosure.mode === "generated" ? I18nKey.postAiGenerated : I18nKey.postAiAssisted);
const providerIcons = new Map([
	["openai", "simple-icons:openai"],
	["anthropic", "simple-icons:anthropic"],
	["google", "simple-icons:googlegemini"],
	["googledeepmind", "simple-icons:googlegemini"],
	["deepseek", "simple-icons:deepseek"],
	["alibaba", "simple-icons:alibabacloud"],
	["alibabacloud", "simple-icons:alibabacloud"],
	["qwen", "simple-icons:alibabacloud"],
	["mistral", "simple-icons:mistralai"],
	["mistralai", "simple-icons:mistralai"],
	["meta", "simple-icons:meta"],
	["github", "simple-icons:githubcopilot"],
	["perplexity", "simple-icons:perplexity"],
]);
---

<div class:list={["flex flex-wrap items-center gap-2", compact ? "mt-2" : "mb-5"]} data-post-ai={disclosure.mode}>
	<span class="inline-flex items-center gap-1.5 rounded-full bg-[var(--tertiary-container)] px-3 py-1 text-xs font-semibold text-[var(--on-tertiary-container)]">
		<Icon icon="material-symbols:auto-awesome-outline-rounded" width={16} height={16} aria-hidden="true" />
		{label}
	</span>
	{!compact && disclosure.models.map(({ provider, name }) => (
		<span class="inline-flex min-w-0 items-center gap-1.5 rounded-[var(--shape-corner-s)] bg-[var(--surface-container)] px-3 py-1 text-sm text-[var(--on-surface)]" data-ai-model>
			<Icon icon={providerIcons.get(provider.toLowerCase().replace(/[^a-z0-9]/g, "")) ?? "material-symbols:smart-toy-outline-rounded"} width={16} height={16} class="shrink-0" aria-hidden="true" />
			<span class="wrap-anywhere">{provider} · {name}</span>
		</span>
	))}
</div>
