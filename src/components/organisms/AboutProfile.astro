---
import Card from "@components/atoms/display/Card.svelte";
import AccentBar from "@components/atoms/display/AccentBar.svelte";
import Icon from "@components/atoms/display/Icon.svelte";
import profileStyles from "@/styles/about-profile.css?raw";
import type { AboutProfileData } from "@/types/aboutProfile";

interface Props {
	profile: AboutProfileData;
}
const { profile } = Astro.props;
---

<div class="about-profile" data-about-profile>
    <style is:inline data-about-profile-styles set:html={profileStyles}></style>
    <Card radius="l" color="var(--card-bg)" class="about-identity">
        <div class="identity-layout">
            <div class="identity-copy">
                <p class="eyebrow"><span class="identity-dot" aria-hidden="true"></span>{profile.eyebrow}</p>
                {profile.avatar && <img class="avatar" src={profile.avatar} alt="" width="80" height="80" decoding="async" />}
                <h1>{profile.name}</h1>
                {profile.alias && <p class="alias">{profile.alias}</p>}
                <p class="introduction">{profile.introduction}</p>
                {!!profile.tags?.length && <ul class="identity-tags">{profile.tags.map(tag => <li>{tag}</li>)}</ul>}
                {!!profile.links?.length && <nav class="identity-links" aria-label={profile.eyebrow}>
                    {profile.links.map(link => <a class="profile-link m3-state-layer" href={link.href}>
                        {link.icon && <Icon icon={link.icon} width={20} height={20} />}
                        <span>{link.label}</span>
                    </a>)}
                </nav>}
            </div>
            {profile.image && <div class="identity-art" aria-hidden="true"><img src={profile.image} alt="" width="640" height="800" decoding="async" /></div>}
        </div>
    </Card>

    <div class="profile-grid">
        {profile.sections.map((section) => <section
            id={`about-${section.id}`}
            class:list={["profile-section", `kind-${section.kind}`, `tone-${section.tone ?? "surface"}`, { "section-wide": section.wide }]}
            aria-labelledby={`about-heading-${section.id}`}
        >
            <Card radius="l" color="var(--profile-card-bg)" class="profile-section-card">
                <div class="section-content">
                    {section.eyebrow && <p class="section-eyebrow">{section.eyebrow}</p>}
                    <div class="section-heading">
                        <AccentBar size="small" color="var(--profile-accent)" />
                        <h2 id={`about-heading-${section.id}`}>{section.title}</h2>
                    </div>
                    {section.text && (section.kind === "quote" ? <blockquote>{section.text}</blockquote> : <p class="section-description">{section.text}</p>)}
                    {section.image && <img class="section-image" src={section.image} alt="" width="640" height="360" loading="lazy" decoding="async" />}

                    {!!section.items?.length && <ul class:list={["section-items", `${section.kind}-items`]}>
                        {section.items.map(item => <li>
                            {section.kind === "posters" ? <a class="poster-link" href={item.href}>
                                <span class="poster-art">
                                    <span class="poster-fallback" aria-hidden="true">{[...item.title].slice(0, 2).join("")}</span>
                                    {item.image && <img src={item.image} alt="" width="240" height="336" loading="lazy" decoding="async" />}
                                </span>
                                <span>{item.title}</span>
                            </a> : <div class="item-row">
                                {item.image && <span class="tool-image"><img src={item.image} alt="" width="36" height="36" loading="lazy" decoding="async" /></span>}
                                <div class="item-copy">
                                    {item.href ? <a class="item-title" href={item.href}>{item.title}<Icon icon="material-symbols:arrow-outward-rounded" width={18} height={18} /></a> : <span class="item-title">{item.title}</span>}
                                    {item.description && <p>{item.description}</p>}
                                </div>
                            </div>}
                        </li>)}
                    </ul>}
                    {section.link && <a class="section-link m3-state-layer" href={section.link.href}><span>{section.link.label}</span><Icon icon="material-symbols:arrow-forward-rounded" width={20} height={20} /></a>}
                </div>
            </Card>
        </section>)}
    </div>
</div>

