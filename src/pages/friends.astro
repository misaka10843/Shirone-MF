---
import FriendSection from "@components/organisms/FriendSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nText } from "@utils/i18n-utils";
import { friendsConfig } from "@/config/friendsConfig";
import { siteConfig } from "@/config/siteConfig";
import * as friendsData from "@/data/friends";
import type { FriendApplication } from "@/types/friendsConfig";
const { getFriendsList } = friendsData;
const friendApplication = (
	friendsData as { friendApplication?: FriendApplication }
).friendApplication;
const Application =
	friendsConfig.showApplication && friendApplication
		? (await import("@components/organisms/FriendApplication.astro")).default
		: null;
const Comments = Application
	? (await import("@components/organisms/comment/CommentSection.astro")).default
	: null;

if (!friendsConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(friendsConfig.title, I18nKey.friends);
const pageDescription = resolveI18nText(
	friendsConfig.description,
	I18nKey.friendsBanner,
);
---

<MainGridLayout title={pageTitle} description={pageDescription} page="friends" hasComments={Boolean(Comments)}>
	<FriendSection
		friends={getFriendsList()}
		title={pageTitle}
		subtitle={pageDescription}
		pageSize={friendsConfig.pageSize}
		client:visible
	/>
	{Application && friendApplication && <Application application={friendApplication} />}
	{Comments && <Comments class="mt-4" context={{key:"page:friends",path:"/friends/",title:pageTitle,language:siteConfig.lang}} />}
</MainGridLayout>
