---
import { getEntry, render } from "astro:content";
import Card from "@components/atoms/display/Card.svelte";
import Markdown from "@components/content/Markdown.astro";
import CommentSection from "@components/organisms/comment/CommentSection.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import I18nKey from "@i18n/i18nKey";
import { guestbookConfig, siteConfig } from "@/config";
import { resolveI18nText } from "@utils/i18n-utils";
const title = resolveI18nText(guestbookConfig.title, I18nKey.guestbook);
if (!guestbookConfig.enable) return Astro.redirect("/404/");
const entry = await getEntry("spec", "guestbook");
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---
<MainGridLayout title={title} description={guestbookConfig.description} page="guestbook" hasComments>
    {Content && <Card color="var(--card-bg)" radius="l" class="p-6 mb-4"><Markdown class=""><Content /></Markdown></Card>}
    <CommentSection context={{ key: "page:guestbook", path: "/guestbook/", title, language: siteConfig.lang }} />
</MainGridLayout>
